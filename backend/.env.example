# Zippy Logistics backend runtime configuration
# Copy to backend/.env for local backend runs, or map these values into Docker/hosting secrets.

# Required
DATABASE_URL=sqlite:///./test.db

# Optional application metadata and logging
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
PORT=8000
JWT_SECRET=change_me_for_pilot_or_production
CORS_ORIGINS=*

# Optional error monitoring placeholder.
# Sentry initializes only when this is set and sentry_sdk is installed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Docker compose runtime defaults.
BACKEND_APP_ENV=pilot
POSTGRES_DB=zippy
POSTGRES_USER=zippy
POSTGRES_PASSWORD=change_me_for_non_local
BACKEND_PORT=8000
