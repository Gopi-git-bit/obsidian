# DeepSeek Harness environment variables
# Copy to dsh/.env and fill in real values.

# Hermes / DeepSeek local Docker endpoint
HERMES_API_KEY=

# Composio + Odoo
COMPOSIO_API_KEY=
ODOO_CONNECTION_ID=

# Supabase (service role key for audit writes)
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# TinyFish (for bi-research agent)
TINYFISH_API_KEY=

# n8n (for automation triggers)
N8N_WEBHOOK_URL=
N8N_API_KEY=
